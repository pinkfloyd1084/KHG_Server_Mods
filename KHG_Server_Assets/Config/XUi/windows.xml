<configs>
	<remove xpath="/windows/window[@name='windowLoadingScreen']/rect[@name='background']" />
	
	<insertAfter xpath="/windows/window[@name='windowLoadingScreen']/rect[@name='backgroundDarkener']">
		<rect name="backgroundKHG" depth="1" pos="0,0">
			<texture name="bgKHG" texture="@modfolder:KHG_Server_Assets/Textures/KHG_Background.png" />
		</rect>
	</insertAfter>

	<set xpath="/windows/window[@name='windowLoadingScreen']/rect[@name='logo']/@visible">false</set>

	<set xpath="/windows/window[@name='windowLoadingScreen']/@sound_open">khg_loading_music</set>
</configs>